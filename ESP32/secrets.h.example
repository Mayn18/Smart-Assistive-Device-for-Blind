// secrets.h.example
#ifndef SECRETS_H
#define SECRETS_H

struct WiFiCred {
  const char* ssid;
  const char* password;
};

const WiFiCred networks[] = {
  {"YOUR_WIFI_SSID", "YOUR_WIFI_PASSWORD"}
};

const int networkCount = sizeof(networks) / sizeof(networks[0]);

#define AP_SSID "ESP32-CAM-READER"
#define AP_PASSWORD "CHANGE_ME_8_CHARS_MIN"

#endif